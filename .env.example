# 复制为 .env 后按需修改。三端服务与 docker compose 共用此文件。

# ---------- PostgreSQL ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=xjl_tl
# 超级用户（仅 docker 初始化使用）
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres
# Spring 使用：拥有 biz / ai 两个 schema，负责 Flyway 迁移
TL_APP_DB_USER=tl_app
TL_APP_DB_PASSWORD=tl_app_pwd
# Python 使用：只读 biz 中被授权的表，读写 ai schema
TL_AI_DB_USER=tl_ai
TL_AI_DB_PASSWORD=tl_ai_pwd

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# ---------- 安全 ----------
# JWT HS256 签名密钥，至少 32 字节；生成：openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-at-least-32-bytes-long
# 模型 API Key 加密密钥：base64 编码的 32 字节；生成：openssl rand -base64 32
MODEL_KEY_SECRET=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Spring 调用 Python 内部接口的共享令牌
INTERNAL_TOKEN=change-me-internal-token

# ---------- 初始管理员（首次启动且无管理员时创建） ----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123456

# ---------- 服务地址 ----------
# Spring 监听端口（本机 8080 被占用时改这里，并同步 web/.env.local）
SERVER_PORT=8080
# Spring 访问 Python AI 服务
AI_SERVICE_URL=http://localhost:8000
# 浏览器访问 Spring
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Spring CORS 允许的前端源
WEB_ORIGIN=http://localhost:3000

# ---------- 翻译记忆（本地 embedding，见 add-session-context-and-memory design D6） ----------
# 关闭后翻译记忆检索返回空、写入返回 C0160，翻译不受影响
TM_ENABLED=true
# fastembed 支持的多语种模型（384 维；更换模型需保证维度一致）
TM_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# 模型缓存目录（相对 python-backend/）
TM_MODEL_CACHE_DIR=.cache/models
# 可选：HuggingFace 镜像（国内网络下载模型时使用）
# HF_ENDPOINT=https://hf-mirror.com

# ---------- 语音、同传与图片翻译（见 add-speech-and-image-translation） ----------
# Spring 保存原图与译图的目录（相对 springboot-backend/）
STORAGE_DIR=./data/storage
# 本地语音模型目录（相对 python-backend/），首次使用前执行：uv run python -m app.speech.download
SPEECH_MODEL_DIR=.cache/speech
# 可选：GitHub 下载镜像前缀，例如 https://ghfast.top/https://github.com
# SPEECH_MODEL_MIRROR=
# 可选：HuggingFace 下载镜像（断句模型 Smart Turn），例如 https://hf-mirror.com
# SPEECH_HF_MIRROR=
# 全局并发发言流上限
INTERPRET_MAX_STREAMS=20
# 两段式断句（见 improve-speech-endpointing-and-live-ux）：判为未说完时的续说等待（毫秒，0 = 旧行为，只按静音断句）
# ENDPOINT_HOLD_MS=700
# ENDPOINT_HOLD_MS_FAST=400
# ENDPOINT_HOLD_MS_CHAT=1500
# ENDPOINT_HOLD_MS_CHAT_FAST=1000
# 声学句末模型 Smart Turn：auto（模型已下载即启用）| on | off；缺省 off（E6 评测见 docs/test/endpointing/report.md），
# 主要用 AI 对话时可开启：碎句进一步减少，完整句约多等 0.15 s
# ENDPOINT_SMART_TURN=off
# 实时语音对话（百炼 server_vad）的断句静音
# REALTIME_CHAT_SILENCE_MS=800
