  {
   "seq": 23,
   "blockType": "paragraph",
   "level": null,
   "prefix": "",
   "source": "Here's an example Pod that uses values from `game-demo` to configure a Pod:",
   "suffix": "\n\n",
   "translatable": true,
   "chunkIndex": 3,
   "target": "下面是一个使用 `game-demo` 中的值来配置 Pod 的 Pod 示例：",
