   "blockType": "paragraph",
   "level": null,
   "prefix": "",
   "source": "ConfigMap does not provide secrecy or encryption.\nIf the data you want to store are confidential, use a\nSecret rather than a ConfigMap,\nor use additional (third party) tools to keep your data private.",
