   "seq": 61,
   "blockType": "paragraph",
   "level": null,
   "prefix": "",
   "source": "This label ensures that child ReplicaSets of a Deployment do not overlap. It is generated by hashing the `PodTemplate` of the ReplicaSet and using the resulting hash as the label value that is added to the ReplicaSet selector, Pod template labels,\nand in any existing Pods that the ReplicaSet might have.",
   "suffix": "\n",
   "translatable": true,
